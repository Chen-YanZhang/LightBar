# LightBar sdkconfig.defaults - target esp32c6, 4MB flash
# NOTE: keep this file pure ASCII (IDF 5.4 kconfgen reads it with system codepage).
CONFIG_IDF_TARGET="esp32c6"

# Flash layout (matches board: 4MB, DIO; 80M validated on old board)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Custom partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Console over native USB Serial/JTAG (no UART connector on board)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Safety & system
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Matter leaves ~1.7 MB of code in a 1.875 MB OTA slot on 4 MB flash (slots
# cannot grow: 0x20000 head + 2*0x1E0000 = 0x400000). Optimize for size.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_CHECKS_SILENT=n
CONFIG_FREERTOS_HZ=1000
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Status LED: PCB3_3 carries ONE addressable RGB LED on GPIO15 (LED2).
CONFIG_LB_WS2812_ENABLE=y
CONFIG_LB_WS2812_GPIO=15
CONFIG_LB_WS2812_COUNT=1

# Matter OTA Requestor (cluster 0x0019). Any Matter controller that can push an
# image can update us - Home Assistant's Matter server does it with developer
# mode enabled, so no CSA/DCL registration is required.
CONFIG_ENABLE_OTA_REQUESTOR=y

# Matter Basic Information strings (VendorName / ProductName / HardwareVersionString)
# live in main/chip_project_config.h; hardware version number 1 = PCB3_3 engineering sample.
CONFIG_CHIP_PROJECT_CONFIG="main/chip_project_config.h"
CONFIG_DEFAULT_DEVICE_HARDWARE_VERSION=1
